# Copy this file to .env only when setting up a deployment.
# `npm run setup-admin -- <username> <strong-password>` writes the three
# ADMIN_* values below as a salted password hash. Never commit .env.

# ADMIN_USERNAME=masjid-admin
# ADMIN_PASSWORD_SALT=generated-by-setup-admin
# ADMIN_PASSWORD_HASH=generated-by-setup-admin

# Vercel Marketplace Upstash Redis (the current successor to Vercel KV).
# The Vercel integration may use either KV_REST_* or UPSTASH_REDIS_REST_* names.
# KV_REST_API_URL=https://your-redis-endpoint.upstash.io
# KV_REST_API_TOKEN=your-redis-token
# UPSTASH_REDIS_REST_URL=https://your-redis-endpoint.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-redis-token
